+package repository
+
+import (
+	"errors"
+	"time"
+
+	"github.com/dujiao-next/internal/models"
+
+	"gorm.io/gorm"
+)
+
+type FansgurusServiceMappingRepository interface {
+	GetByConnectionAndServiceID(connectionID, serviceID uint) (*models.FansgurusServiceMapping, error)
+	ListByConnection(connectionID uint) ([]models.FansgurusServiceMapping, error)
+	Create(mapping *models.FansgurusServiceMapping) error
+	Update(mapping *models.FansgurusServiceMapping) error
+	MarkMissingInactive(connectionID uint, seenServiceIDs []uint, now time.Time) (int64, error)
+}
+
+type GormFansgurusServiceMappingRepository struct {
+	db *gorm.DB
+}
+
+func NewFansgurusServiceMappingRepository(db *gorm.DB) *GormFansgurusServiceMappingRepository {
+	return &GormFansgurusServiceMappingRepository{db: db}
+}
+
+func (r *GormFansgurusServiceMappingRepository) GetByConnectionAndServiceID(connectionID, serviceID uint) (*models.FansgurusServiceMapping, error) {
+	var mapping models.FansgurusServiceMapping
+	if err := r.db.Where("connection_id = ? AND upstream_service_id = ?", connectionID, serviceID).First(&mapping).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, nil
+		}
+		return nil, err
+	}
+	return &mapping, nil
+}
+
+func (r *GormFansgurusServiceMappingRepository) ListByConnection(connectionID uint) ([]models.FansgurusServiceMapping, error) {
+	var mappings []models.FansgurusServiceMapping
+	if err := r.db.Where("connection_id = ?", connectionID).Order("upstream_service_id ASC").Find(&mappings).Error; err != nil {
+		return nil, err
+	}
+	return mappings, nil
+}
+
+func (r *GormFansgurusServiceMappingRepository) Create(mapping *models.FansgurusServiceMapping) error {
+	return r.db.Create(mapping).Error
+}
+
+func (r *GormFansgurusServiceMappingRepository) Update(mapping *models.FansgurusServiceMapping) error {
+	return r.db.Save(mapping).Error
+}
+
+func (r *GormFansgurusServiceMappingRepository) MarkMissingInactive(connectionID uint, seenServiceIDs []uint, now time.Time) (int64, error) {
+	query := r.db.Model(&models.FansgurusServiceMapping{}).
+		Where("connection_id = ? AND is_active = ?", connectionID, true)
+	if len(seenServiceIDs) > 0 {
+		query = query.Where("upstream_service_id NOT IN ?", seenServiceIDs)
+	}
+	result := query.Updates(map[string]interface{}{
+		"is_active":  false,
+		"updated_at": now,
+	})
+	if result.Error != nil {
+		return 0, result.Error
+	}
+	return result.RowsAffected, nil
+}
+
+type FansgurusSyncRunRepository interface {
+	Create(run *models.FansgurusSyncRun) error
+	Update(run *models.FansgurusSyncRun) error
+	GetByID(id uint) (*models.FansgurusSyncRun, error)
+}
+
+type GormFansgurusSyncRunRepository struct {
+	db *gorm.DB
+}
+
+func NewFansgurusSyncRunRepository(db *gorm.DB) *GormFansgurusSyncRunRepository {
+	return &GormFansgurusSyncRunRepository{db: db}
+}
+
+func (r *GormFansgurusSyncRunRepository) Create(run *models.FansgurusSyncRun) error {
+	return r.db.Create(run).Error
+}
+
+func (r *GormFansgurusSyncRunRepository) Update(run *models.FansgurusSyncRun) error {
+	return r.db.Save(run).Error
+}
+
+func (r *GormFansgurusSyncRunRepository) GetByID(id uint) (*models.FansgurusSyncRun, error) {
+	var run models.FansgurusSyncRun
+	if err := r.db.First(&run, id).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, nil
+		}
+		return nil, err
+	}
+	return &run, nil
+}
