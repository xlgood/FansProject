@@ -0,0 +1,197 @@
+package service
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/dujiao-next/internal/constants"
+	"github.com/dujiao-next/internal/crypto"
+	"github.com/dujiao-next/internal/models"
+	"github.com/dujiao-next/internal/repository"
+	"github.com/dujiao-next/internal/upstream"
+
+	"github.com/glebarez/sqlite"
+	"github.com/shopspring/decimal"
+	"gorm.io/gorm"
+)
+
+type fakeFansgurusClient struct {
+	services []upstream.FansgurusService
+	err      error
+}
+
+func (c *fakeFansgurusClient) ListServices(ctx context.Context) ([]upstream.FansgurusService, error) {
+	if c.err != nil {
+		return nil, c.err
+	}
+	return c.services, nil
+}
+
+func TestFansgurusSyncServiceCreatesUpdatesAndDeactivatesMappings(t *testing.T) {
+	svc, mappingRepo, runRepo, db := setupFansgurusSyncTest(t)
+	conn := createFansgurusConnection(t, db, 1)
+	now := time.Now().Add(-time.Hour)
+	if err := mappingRepo.Create(&models.FansgurusServiceMapping{
+		ConnectionID:      conn.ID,
+		UpstreamServiceID: 900,
+		ServiceName:       "Old service",
+		ServiceType:       FansgurusServiceTypeDefault,
+		IsActive:          true,
+		LastSeenAt:        &now,
+	}); err != nil {
+		t.Fatalf("create stale mapping: %v", err)
+	}
+	if err := mappingRepo.Create(&models.FansgurusServiceMapping{
+		ConnectionID:      conn.ID,
+		UpstreamServiceID: 100,
+		ServiceName:       "Old name",
+		ServiceType:       FansgurusServiceTypeDefault,
+		IsActive:          true,
+		LastSeenAt:        &now,
+		ContentHash:       "old",
+	}); err != nil {
+		t.Fatalf("create existing mapping: %v", err)
+	}
+
+	svc.SetClientFactory(func(conn *models.SiteConnection, secret string) FansgurusServiceClient {
+		if secret != "plain-secret" {
+			t.Fatalf("secret=%s, want decrypted secret", secret)
+		}
+		return &fakeFansgurusClient{services: []upstream.FansgurusService{
+			{
+				Service:  100,
+				Name:     "Telegram Members",
+				Type:     FansgurusServiceTypeDefault,
+				Rate:     "0.30",
+				Min:      100,
+				Max:      10000,
+				Refill:   true,
+				Category: "Telegram",
+			},
+			{
+				Service:  200,
+				Name:     "Instagram Comments",
+				Type:     FansgurusServiceTypeCustomComments,
+				Rate:     "1.25",
+				Min:      10,
+				Max:      1000,
+				Category: "Instagram",
+			},
+			{
+				Service:  300,
+				Name:     "Unsupported",
+				Type:     "Subscriptions",
+				Rate:     "1.00",
+				Category: "Other",
+			},
+		}}
+	})
+
+	run, err := svc.SyncConnection(context.Background(), conn.ID)
+	if err != nil {
+		t.Fatalf("SyncConnection: %v", err)
+	}
+	if run.Status != models.FansgurusSyncStatusSucceeded {
+		t.Fatalf("status=%s, want succeeded", run.Status)
+	}
+	if run.FetchedCount != 3 || run.CreatedCount != 1 || run.UpdatedCount != 1 || run.UnsupportedCount != 1 || run.DeactivatedCount != 1 {
+		t.Fatalf("unexpected counters: %+v", run)
+	}
+
+	created, err := mappingRepo.GetByConnectionAndServiceID(conn.ID, 200)
+	if err != nil {
+		t.Fatalf("get created: %v", err)
+	}
+	if created == nil || !created.IsActive || !created.SellRate.Decimal.Equal(created.UpstreamRate.Decimal.Mul(decimal.NewFromInt(10))) {
+		t.Fatalf("unexpected created mapping: %+v", created)
+	}
+	if created.PurchaseEnabled {
+		t.Fatalf("new mappings should not be purchase enabled by default")
+	}
+
+	updated, err := mappingRepo.GetByConnectionAndServiceID(conn.ID, 100)
+	if err != nil {
+		t.Fatalf("get updated: %v", err)
+	}
+	if updated == nil || updated.ServiceName != "Telegram Members" || !updated.SupportsRefill {
+		t.Fatalf("unexpected updated mapping: %+v", updated)
+	}
+
+	stale, err := mappingRepo.GetByConnectionAndServiceID(conn.ID, 900)
+	if err != nil {
+		t.Fatalf("get stale: %v", err)
+	}
+	if stale == nil || stale.IsActive {
+		t.Fatalf("expected stale mapping inactive, got %+v", stale)
+	}
+
+	persistedRun, err := runRepo.GetByID(run.ID)
+	if err != nil {
+		t.Fatalf("get run: %v", err)
+	}
+	if persistedRun == nil || persistedRun.FinishedAt == nil {
+		t.Fatalf("expected persisted finished run, got %+v", persistedRun)
+	}
+}
+
+func TestFansgurusSyncServiceRejectsNonFansgurusConnection(t *testing.T) {
+	svc, _, _, db := setupFansgurusSyncTest(t)
+	encrypted, err := crypto.Encrypt(crypto.DeriveKey("app-secret"), "plain-secret")
+	if err != nil {
+		t.Fatalf("encrypt: %v", err)
+	}
+	conn := &models.SiteConnection{
+		Name:      "Dujiao",
+		BaseURL:   "https://dujiao.test",
+		ApiKey:    "api-key",
+		ApiSecret: encrypted,
+		Protocol:  constants.ConnectionProtocolDujiaoNext,
+		Status:    constants.ConnectionStatusActive,
+	}
+	if err := db.Create(conn).Error; err != nil {
+		t.Fatalf("create connection: %v", err)
+	}
+
+	_, err = svc.SyncConnection(context.Background(), conn.ID)
+	if err != ErrFansgurusConnectionInvalid {
+		t.Fatalf("err=%v, want ErrFansgurusConnectionInvalid", err)
+	}
+}
+
+func setupFansgurusSyncTest(t *testing.T) (*FansgurusSyncService, repository.FansgurusServiceMappingRepository, repository.FansgurusSyncRunRepository, *gorm.DB) {
+	t.Helper()
+	db, err := gorm.Open(sqlite.Open("file:fansgurus_sync?mode=memory&cache=shared"), &gorm.Config{})
+	if err != nil {
+		t.Fatalf("open db: %v", err)
+	}
+	if err := db.AutoMigrate(&models.SiteConnection{}, &models.FansgurusServiceMapping{}, &models.FansgurusSyncRun{}); err != nil {
+		t.Fatalf("migrate: %v", err)
+	}
+	connRepo := repository.NewSiteConnectionRepository(db)
+	connSvc := NewSiteConnectionService(connRepo, "app-secret", "uploads")
+	mappingRepo := repository.NewFansgurusServiceMappingRepository(db)
+	runRepo := repository.NewFansgurusSyncRunRepository(db)
+	return NewFansgurusSyncService(connSvc, mappingRepo, runRepo), mappingRepo, runRepo, db
+}
+
+func createFansgurusConnection(t *testing.T, db *gorm.DB, id uint) *models.SiteConnection {
+	t.Helper()
+	encrypted, err := crypto.Encrypt(crypto.DeriveKey("app-secret"), "plain-secret")
+	if err != nil {
+		t.Fatalf("encrypt: %v", err)
+	}
+	conn := &models.SiteConnection{
+		ID:        id,
+		Name:      "Fansgurus",
+		BaseURL:   "https://fansgurus.test/api/v2",
+		ApiKey:    "api-key",
+		ApiSecret: encrypted,
+		Protocol:  constants.ConnectionProtocolFansgurus,
+		Status:    constants.ConnectionStatusActive,
+	}
+	if err := db.Create(conn).Error; err != nil {
+		t.Fatalf("create connection: %v", err)
+	}
+	return conn
+}
