+package repository
+
+import (
+	"testing"
+	"time"
+
+	"github.com/dujiao-next/internal/models"
+
+	"github.com/glebarez/sqlite"
+	"gorm.io/gorm"
+)
+
+func TestFansgurusServiceMappingRepositoryMarkMissingInactive(t *testing.T) {
+	db, err := gorm.Open(sqlite.Open("file:fansgurus_repo?mode=memory&cache=shared"), &gorm.Config{})
+	if err != nil {
+		t.Fatalf("open db: %v", err)
+	}
+	if err := db.AutoMigrate(&models.FansgurusServiceMapping{}); err != nil {
+		t.Fatalf("migrate: %v", err)
+	}
+
+	repo := NewFansgurusServiceMappingRepository(db)
+	now := time.Now()
+	for _, serviceID := range []uint{101, 102, 201} {
+		if err := repo.Create(&models.FansgurusServiceMapping{
+			ConnectionID:      1,
+			UpstreamServiceID: serviceID,
+			ServiceName:       "service",
+			IsActive:          true,
+			LastSeenAt:        &now,
+		}); err != nil {
+			t.Fatalf("create mapping: %v", err)
+		}
+	}
+	if err := repo.Create(&models.FansgurusServiceMapping{
+		ConnectionID:      2,
+		UpstreamServiceID: 301,
+		ServiceName:       "other connection",
+		IsActive:          true,
+		LastSeenAt:        &now,
+	}); err != nil {
+		t.Fatalf("create other mapping: %v", err)
+	}
+
+	changed, err := repo.MarkMissingInactive(1, []uint{101, 201}, time.Now())
+	if err != nil {
+		t.Fatalf("MarkMissingInactive: %v", err)
+	}
+	if changed != 1 {
+		t.Fatalf("changed=%d, want 1", changed)
+	}
+
+	missing, err := repo.GetByConnectionAndServiceID(1, 102)
+	if err != nil {
+		t.Fatalf("get missing: %v", err)
+	}
+	if missing == nil || missing.IsActive {
+		t.Fatalf("expected service 102 inactive, got %+v", missing)
+	}
+	other, err := repo.GetByConnectionAndServiceID(2, 301)
+	if err != nil {
+		t.Fatalf("get other: %v", err)
+	}
+	if other == nil || !other.IsActive {
+		t.Fatalf("expected other connection untouched, got %+v", other)
+	}
+}
diff --git a/internal/service/fansgurus_sync.go b/internal/service/fansgurus_sync.go
new file mode 100644
index 0000000..66e0e3c
--- /dev/null
+++ b/internal/service/fansgurus_sync.go
@@ -0,0 +1,232 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/dujiao-next/internal/constants"
+	"github.com/dujiao-next/internal/models"
+	"github.com/dujiao-next/internal/repository"
+	"github.com/dujiao-next/internal/upstream"
+
+	"github.com/shopspring/decimal"
+)
+
+var (
+	ErrFansgurusConnectionInvalid = errors.New("fansgurus connection is invalid")
+	ErrFansgurusSyncClientMissing = errors.New("fansgurus sync client is missing")
+)
+
+type FansgurusServiceClient interface {
+	ListServices(ctx context.Context) ([]upstream.FansgurusService, error)
+}
+
+type FansgurusClientFactory func(conn *models.SiteConnection, decryptedSecret string) FansgurusServiceClient
+
+type FansgurusSyncService struct {
+	connService *SiteConnectionService
+	mappingRepo repository.FansgurusServiceMappingRepository
+	runRepo     repository.FansgurusSyncRunRepository
+	clientFor   FansgurusClientFactory
+}
+
+func NewFansgurusSyncService(
+	connService *SiteConnectionService,
+	mappingRepo repository.FansgurusServiceMappingRepository,
+	runRepo repository.FansgurusSyncRunRepository,
+) *FansgurusSyncService {
+	return &FansgurusSyncService{
+		connService: connService,
+		mappingRepo: mappingRepo,
+		runRepo:     runRepo,
+		clientFor: func(conn *models.SiteConnection, decryptedSecret string) FansgurusServiceClient {
+			return upstream.NewFansgurusClient(conn.BaseURL, decryptedSecret)
+		},
+	}
+}
+
+func (s *FansgurusSyncService) SetClientFactory(factory FansgurusClientFactory) {
+	if factory != nil {
+		s.clientFor = factory
+	}
+}
+
+func (s *FansgurusSyncService) SyncConnection(ctx context.Context, connectionID uint) (*models.FansgurusSyncRun, error) {
+	if s == nil || s.connService == nil || s.mappingRepo == nil || s.runRepo == nil || s.clientFor == nil {
+		return nil, ErrFansgurusSyncClientMissing
+	}
+
+	conn, err := s.connService.GetByID(connectionID)
+	if err != nil {
+		return nil, err
+	}
+	if conn == nil {
+		return nil, ErrConnectionNotFound
+	}
+	if strings.TrimSpace(conn.Protocol) != constants.ConnectionProtocolFansgurus {
+		return nil, ErrFansgurusConnectionInvalid
+	}
+
+	run := &models.FansgurusSyncRun{
+		ConnectionID: connectionID,
+		Status:       models.FansgurusSyncStatusRunning,
+		StartedAt:    time.Now(),
+	}
+	if err := s.runRepo.Create(run); err != nil {
+		return nil, err
+	}
+
+	if err := s.syncWithRun(ctx, conn, run); err != nil {
+		finished := time.Now()
+		run.Status = models.FansgurusSyncStatusFailed
+		run.FinishedAt = &finished
+		run.ErrorMessage = err.Error()
+		_ = s.runRepo.Update(run)
+		return run, err
+	}
+
+	finished := time.Now()
+	run.Status = models.FansgurusSyncStatusSucceeded
+	run.FinishedAt = &finished
+	if err := s.runRepo.Update(run); err != nil {
+		return nil, err
+	}
+	return run, nil
+}
+
+func (s *FansgurusSyncService) syncWithRun(ctx context.Context, conn *models.SiteConnection, run *models.FansgurusSyncRun) error {
+	decrypted, err := s.connService.decryptSecret(conn)
+	if err != nil {
+		return err
+	}
+	client := s.clientFor(conn, decrypted)
+	if client == nil {
+		return ErrFansgurusSyncClientMissing
+	}
+
+	services, err := client.ListServices(ctx)
+	if err != nil {
+		return err
+	}
+	run.ResponseBytes = estimateFansgurusResponseBytes(services)
+
+	now := time.Now()
+	seen := make([]uint, 0, len(services))
+	for _, service := range services {
+		run.FetchedCount++
+		seen = append(seen, service.Service)
+		if !IsFansgurusServiceTypeSupported(service.Type) {
+			run.UnsupportedCount++
+			continue
+		}
+		if err := s.upsertServiceMapping(conn.ID, service, now, run); err != nil {
+			run.ErrorCount++
+			return err
+		}
+	}
+
+	count, err := s.mappingRepo.MarkMissingInactive(conn.ID, seen, now)
+	if err != nil {
+		run.ErrorCount++
+		return err
+	}
+	run.DeactivatedCount += int(count)
+	return nil
+}
+
+func (s *FansgurusSyncService) upsertServiceMapping(connectionID uint, service upstream.FansgurusService, now time.Time, run *models.FansgurusSyncRun) error {
+	upstreamRate, err := decimal.NewFromString(strings.TrimSpace(service.Rate))
+	if err != nil {
+		return fmt.Errorf("parse fansgurus rate for service %d: %w", service.Service, err)
+	}
+	if upstreamRate.IsNegative() {
+		upstreamRate = decimal.Zero
+	}
+
+	payload := fansgurusServicePayload(service)
+	hash, err := FansgurusContentHash(payload)
+	if err != nil {
+		return err
+	}
+
+	mapping, err := s.mappingRepo.GetByConnectionAndServiceID(connectionID, service.Service)
+	if err != nil {
+		return err
+	}
+	if mapping == nil {
+		mapping = &models.FansgurusServiceMapping{
+			ConnectionID:      connectionID,
+			UpstreamServiceID: service.Service,
+			PurchaseEnabled:   false,
+			CreatedAt:         now,
+		}
+		applyFansgurusServiceMapping(mapping, service, upstreamRate, payload, hash, now)
+		if err := s.mappingRepo.Create(mapping); err != nil {
+			return err
+		}
+		run.CreatedCount++
+		return nil
+	}
+
+	changed := !mapping.IsActive || mapping.ContentHash != hash || mapping.ServiceType != strings.TrimSpace(service.Type)
+	applyFansgurusServiceMapping(mapping, service, upstreamRate, payload, hash, now)
+	if err := s.mappingRepo.Update(mapping); err != nil {
+		return err
+	}
+	if changed {
+		run.UpdatedCount++
+	}
+	return nil
+}
+
+func applyFansgurusServiceMapping(
+	mapping *models.FansgurusServiceMapping,
+	service upstream.FansgurusService,
+	upstreamRate decimal.Decimal,
+	payload models.JSON,
+	hash string,
+	now time.Time,
+) {
+	mapping.CategoryName = strings.TrimSpace(service.Category)
+	mapping.ServiceName = strings.TrimSpace(service.Name)
+	mapping.ServiceType = strings.TrimSpace(service.Type)
+	mapping.UpstreamRate = models.NewMoneyFromDecimal(upstreamRate)
+	mapping.SellRate = models.NewMoneyFromDecimal(CalculateFansgurusSellRate(upstreamRate))
+	mapping.MinQuantity = service.Min
+	mapping.MaxQuantity = service.Max
+	mapping.SupportsDripfeed = service.Dripfeed
+	mapping.SupportsRefill = service.Refill
+	mapping.SupportsCancel = service.Cancel
+	mapping.RawPayloadJSON = payload
+	mapping.ContentHash = hash
+	mapping.IsActive = true
+	mapping.LastSeenAt = &now
+	mapping.UpdatedAt = now
+}
+
+func fansgurusServicePayload(service upstream.FansgurusService) models.JSON {
+	return models.JSON{
+		"service":  service.Service,
+		"name":     service.Name,
+		"type":     service.Type,
+		"rate":     service.Rate,
+		"min":      service.Min,
+		"max":      service.Max,
+		"dripfeed": service.Dripfeed,
+		"refill":   service.Refill,
+		"cancel":   service.Cancel,
+		"category": service.Category,
+	}
+}
+
+func estimateFansgurusResponseBytes(services []upstream.FansgurusService) int64 {
+	body, err := json.Marshal(services)
+	if err != nil {
+		return 0
+	}
+	return int64(len(body))
+}
