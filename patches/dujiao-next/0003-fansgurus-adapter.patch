+package upstream
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	"github.com/dujiao-next/internal/constants"
+	"github.com/dujiao-next/internal/models"
+)
+
+func TestNewAdapterReturnsFansgurusAdapter(t *testing.T) {
+	adapter, err := NewAdapter(&models.SiteConnection{
+		Protocol:  constants.ConnectionProtocolFansgurus,
+		BaseURL:   "https://fansgurus.test/api/v2",
+		ApiSecret: "secret-key",
+	}, "")
+	if err != nil {
+		t.Fatalf("NewAdapter: %v", err)
+	}
+	if _, ok := adapter.(*FansgurusAdapter); !ok {
+		t.Fatalf("adapter type=%T, want *FansgurusAdapter", adapter)
+	}
+}
+
+func TestFansgurusAdapterPing(t *testing.T) {
+	server := newFansgurusTestServer(t, func(r *http.Request) interface{} {
+		assertFansgurusAction(t, r, "balance")
+		return map[string]string{"balance": "50.00", "currency": "USD"}
+	})
+	defer server.Close()
+
+	adapter := newFansgurusAdapterWithClient(NewFansgurusClient(server.URL, "secret-key"))
+	result, err := adapter.Ping(context.Background())
+	if err != nil {
+		t.Fatalf("Ping: %v", err)
+	}
+	if result.SiteName != "Fansgurus" || result.ProtocolVersion != "fansgurus" || result.Balance != "50.00" {
+		t.Fatalf("unexpected ping result: %+v", result)
+	}
+}
+
+func TestFansgurusAdapterListProductsMapsServices(t *testing.T) {
+	server := newFansgurusTestServer(t, func(r *http.Request) interface{} {
+		assertFansgurusAction(t, r, "services")
+		return []map[string]interface{}{
+			{
+				"service":  16252,
+				"name":     "Telegram Members",
+				"type":     "Default",
+				"rate":     "0.30",
+				"min":      500,
+				"max":      100000,
+				"dripfeed": false,
+				"refill":   true,
+				"cancel":   false,
+				"category": "Telegram",
+			},
+			{
+				"service":  17001,
+				"name":     "Instagram Comments",
+				"type":     "Custom Comments",
+				"rate":     "1.25",
+				"min":      10,
+				"max":      1000,
+				"category": "Instagram",
+			},
+		}
+	})
+	defer server.Close()
+
+	adapter := newFansgurusAdapterWithClient(NewFansgurusClient(server.URL, "secret-key"))
+	result, err := adapter.ListProducts(context.Background(), ListProductsOpts{Page: 1, PageSize: 1})
+	if err != nil {
+		t.Fatalf("ListProducts: %v", err)
+	}
+	if result.Total != 2 || len(result.Items) != 1 {
+		t.Fatalf("total=%d len=%d, want total 2 len 1", result.Total, len(result.Items))
+	}
+	product := result.Items[0]
+	if product.ID != 16252 || product.PriceAmount != "3.00" || product.Currency != "USD" {
+		t.Fatalf("unexpected product: %+v", product)
+	}
+	if len(product.SKUs) != 1 || product.SKUs[0].ID != 16252 || product.SKUs[0].PriceAmount != "3.00" {
+		t.Fatalf("unexpected sku: %+v", product.SKUs)
+	}
+	fields, ok := product.ManualFormSchema["fields"].([]interface{})
+	if !ok || len(fields) != 1 {
+		t.Fatalf("unexpected manual form schema: %+v", product.ManualFormSchema)
+	}
+}
+
+func TestFansgurusAdapterGetProduct(t *testing.T) {
+	server := newFansgurusTestServer(t, func(r *http.Request) interface{} {
+		assertFansgurusAction(t, r, "services")
+		return []map[string]interface{}{
+			{"service": 16252, "name": "Telegram Members", "type": "Default", "rate": "0.30", "category": "Telegram"},
+		}
+	})
+	defer server.Close()
+
+	adapter := newFansgurusAdapterWithClient(NewFansgurusClient(server.URL, "secret-key"))
+	product, err := adapter.GetProduct(context.Background(), 16252)
+	if err != nil {
+		t.Fatalf("GetProduct: %v", err)
+	}
+	if product.ID != 16252 {
+		t.Fatalf("product id=%d, want 16252", product.ID)
+	}
+	_, err = adapter.GetProduct(context.Background(), 99999)
+	if err != ErrUpstreamProductDeleted {
+		t.Fatalf("missing product error=%v, want ErrUpstreamProductDeleted", err)
+	}
+}
+
+func TestFansgurusAdapterCreateOrderMapsManualForm(t *testing.T) {
+	server := newFansgurusTestServer(t, func(r *http.Request) interface{} {
+		assertFansgurusAction(t, r, "add")
+		if got := r.FormValue("service"); got != "16252" {
+			t.Fatalf("service=%s, want 16252", got)
+		}
+		if got := r.FormValue("link"); got != "https://example.com/post" {
+			t.Fatalf("link=%s", got)
+		}
+		if got := r.FormValue("comments"); got != "hello" {
+			t.Fatalf("comments=%s, want hello", got)
+		}
+		if got := r.FormValue("quantity"); got != "500" {
+			t.Fatalf("quantity=%s, want 500", got)
+		}
+		return map[string]interface{}{"order": 123456, "charge": "0.15"}
+	})
+	defer server.Close()
+
+	adapter := newFansgurusAdapterWithClient(NewFansgurusClient(server.URL, "secret-key"))
+	resp, err := adapter.CreateOrder(context.Background(), CreateUpstreamOrderReq{
+		SKUID:    16252,
+		Quantity: 500,
+		ManualFormData: models.JSON{
+			"link":     "https://example.com/post",
+			"comments": "hello",
+		},
+	})
+	if err != nil {
+		t.Fatalf("CreateOrder: %v", err)
+	}
+	if !resp.OK || resp.OrderID != 123456 || resp.Amount != "0.15" {
+		t.Fatalf("unexpected create response: %+v", resp)
+	}
+}
+
+func TestFansgurusAdapterGetOrder(t *testing.T) {
+	server := newFansgurusTestServer(t, func(r *http.Request) interface{} {
+		assertFansgurusAction(t, r, "status")
+		return map[string]string{
+			"status":      "Completed",
+			"charge":      "0.15",
+			"start_count": "100",
+			"remains":     "0",
+			"currency":    "USD",
+		}
+	})
+	defer server.Close()
+
+	adapter := newFansgurusAdapterWithClient(NewFansgurusClient(server.URL, "secret-key"))
+	order, err := adapter.GetOrder(context.Background(), 123456)
+	if err != nil {
+		t.Fatalf("GetOrder: %v", err)
+	}
+	if order.OrderID != 123456 || order.Status != "delivered" || order.Amount != "0.15" {
+		t.Fatalf("unexpected order: %+v", order)
+	}
+	if order.Fulfillment == nil || order.Fulfillment.DeliveryData["remains"] != "0" {
+		t.Fatalf("unexpected fulfillment: %+v", order.Fulfillment)
+	}
+}
+
+func TestNormalizeFansgurusOrderStatus(t *testing.T) {
+	cases := map[string]string{
+		"Completed":   "delivered",
+		"In progress": "fulfilling",
+		"Processing":  "fulfilling",
+		"Partial":     "partially_refunded",
+		"Canceled":    "canceled",
+	}
+	for input, want := range cases {
+		if got := normalizeFansgurusOrderStatus(input); got != want {
+			t.Fatalf("normalizeFansgurusOrderStatus(%q)=%q, want %q", input, got, want)
+		}
+	}
+}
