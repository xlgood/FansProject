+package upstream
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/dujiao-next/internal/models"
+
+	"github.com/shopspring/decimal"
+)
+
+const (
+	fansgurusCurrency       = "USD"
+	fansgurusProtocol       = "fansgurus"
+	fansgurusPriceMult      = 10
+	fansgurusStatusPending  = "pending"
+	fansgurusStatusRunning  = "fulfilling"
+	fansgurusStatusComplete = "delivered"
+	fansgurusStatusCanceled = "canceled"
+	fansgurusStatusFailed   = "failed"
+	fansgurusStatusPartial  = "partially_refunded"
+)
+
+type FansgurusAdapter struct {
+	client *FansgurusClient
+}
+
+func NewFansgurusAdapter(conn *models.SiteConnection) *FansgurusAdapter {
+	return &FansgurusAdapter{
+		client: NewFansgurusClient(conn.BaseURL, conn.ApiSecret),
+	}
+}
+
+func newFansgurusAdapterWithClient(client *FansgurusClient) *FansgurusAdapter {
+	return &FansgurusAdapter{client: client}
+}
+
+func (a *FansgurusAdapter) Ping(ctx context.Context) (*PingResult, error) {
+	balance, err := a.client.GetBalance(ctx)
+	if err != nil {
+		return nil, err
+	}
+	currency := strings.TrimSpace(balance.Currency)
+	if currency == "" {
+		currency = fansgurusCurrency
+	}
+	return &PingResult{
+		SiteName:        "Fansgurus",
+		ProtocolVersion: fansgurusProtocol,
+		Balance:         balance.Balance,
+		Currency:        currency,
+	}, nil
+}
+
+func (a *FansgurusAdapter) ListCategories(ctx context.Context) (*CategoryListResult, error) {
+	services, err := a.client.ListServices(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	seen := make(map[string]uint)
+	categories := make([]UpstreamCategory, 0)
+	for _, service := range services {
+		name := strings.TrimSpace(service.Category)
+		if name == "" {
+			name = "Fansgurus"
+		}
+		if _, ok := seen[name]; ok {
+			continue
+		}
+		id := uint(len(categories) + 1)
+		seen[name] = id
+		categories = append(categories, UpstreamCategory{
+			ID:        id,
+			Slug:      slugifyFansgurusCategory(name),
+			Name:      localizedFansgurusText(name),
+			SortOrder: len(categories) + 1,
+		})
+	}
+
+	return &CategoryListResult{Supported: true, Categories: categories}, nil
+}
+
+func (a *FansgurusAdapter) ListProducts(ctx context.Context, opts ListProductsOpts) (*ProductListResult, error) {
+	services, err := a.client.ListServices(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	categories := fansgurusCategoryIDs(services)
+	products := make([]UpstreamProduct, 0, len(services))
+	for _, service := range services {
+		product, err := fansgurusServiceToProduct(service, categories)
+		if err != nil {
+			return nil, err
+		}
+		products = append(products, product)
+	}
+
+	return &ProductListResult{
+		Total:            len(products),
+		Items:            paginateFansgurusProducts(products, opts),
+		IncludesInactive: false,
+	}, nil
+}
+
+func (a *FansgurusAdapter) GetProduct(ctx context.Context, productID uint) (*UpstreamProduct, error) {
+	services, err := a.client.ListServices(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	categories := fansgurusCategoryIDs(services)
+	for _, service := range services {
+		if service.Service != productID {
+			continue
+		}
+		product, err := fansgurusServiceToProduct(service, categories)
+		if err != nil {
+			return nil, err
+		}
+		return &product, nil
+	}
+	return nil, ErrUpstreamProductDeleted
+}
+
+func (a *FansgurusAdapter) CreateOrder(ctx context.Context, req CreateUpstreamOrderReq) (*CreateUpstreamOrderResp, error) {
+	orderReq := FansgurusAddOrderRequest{
+		Service:  req.SKUID,
+		Quantity: req.Quantity,
+	}
+	orderReq.Link = stringFromJSON(req.ManualFormData, "link")
+	orderReq.Comments = stringFromJSON(req.ManualFormData, "comments")
+	orderReq.AnswerNumber = stringFromJSON(req.ManualFormData, "answer_number")
+	orderReq.Usernames = stringFromJSON(req.ManualFormData, "usernames")
+
+	resp, err := a.client.AddOrder(ctx, orderReq)
+	if err != nil {
+		return nil, err
+	}
+	return &CreateUpstreamOrderResp{
+		OK:       true,
+		OrderID:  resp.Order,
+		OrderNo:  fmt.Sprintf("%d", resp.Order),
+		Status:   fansgurusStatusPending,
+		Amount:   resp.Charge,
+		Currency: fansgurusCurrency,
+	}, nil
+}
+
+func (a *FansgurusAdapter) GetOrder(ctx context.Context, orderID uint) (*UpstreamOrderDetail, error) {
+	status, err := a.client.GetOrderStatus(ctx, orderID)
+	if err != nil {
+		return nil, err
+	}
+
+	currency := strings.TrimSpace(status.Currency)
+	if currency == "" {
+		currency = fansgurusCurrency
+	}
+	return &UpstreamOrderDetail{
+		OrderID:  orderID,
+		OrderNo:  fmt.Sprintf("%d", orderID),
+		Status:   normalizeFansgurusOrderStatus(status.Status),
+		Amount:   status.Charge,
+		Currency: currency,
+		Fulfillment: &UpstreamFulfillment{
+			Type:   "upstream",
+			Status: normalizeFansgurusOrderStatus(status.Status),
+			DeliveryData: models.JSON{
+				"fansgurus_status": status.Status,
+				"start_count":      status.StartCount,
+				"remains":          status.Remains,
+			},
+		},
+	}, nil
+}
+
+func (a *FansgurusAdapter) CancelOrder(ctx context.Context, orderID uint) error {
+	return fmt.Errorf("fansgurus cancel order is not supported")
+}
+
+func (a *FansgurusAdapter) DownloadImage(ctx context.Context, imageURL string) (string, error) {
+	return "", fmt.Errorf("fansgurus image download is not supported")
+}
+
+func fansgurusServiceToProduct(service FansgurusService, categories map[string]uint) (UpstreamProduct, error) {
+	rate, err := decimal.NewFromString(strings.TrimSpace(service.Rate))
+	if err != nil {
+		return UpstreamProduct{}, fmt.Errorf("parse fansgurus rate for service %d: %w", service.Service, err)
+	}
+	price := rate.Mul(decimal.NewFromInt(fansgurusPriceMult)).Round(2).StringFixed(2)
+	formSchema := buildFansgurusManualFormSchema(service.Type)
+	categoryID := categories[normalizedFansgurusCategory(service.Category)]
+
+	sku := UpstreamSKU{
+		ID:            service.Service,
+		SKUCode:       fmt.Sprintf("fansgurus-%d", service.Service),
+		SpecValues:    models.JSON{"service_type": service.Type},
+		PriceAmount:   price,
+		OriginalPrice: rate.Round(2).StringFixed(2),
+		StockStatus:   "in_stock",
+		StockQuantity: -1,
+		IsActive:      true,
+	}
+	return UpstreamProduct{
+		ID:               service.Service,
+		SeoMeta:          models.JSON{},
+		Title:            localizedFansgurusText(service.Name),
+		Description:      localizedFansgurusText(service.Category),
+		Content:          localizedFansgurusText(service.Name),
+		Tags:             []string{service.Category, service.Type},
+		PriceAmount:      price,
+		OriginalPrice:    rate.Round(2).StringFixed(2),
+		Currency:         fansgurusCurrency,
+		FulfillmentType:  "upstream",
+		ManualFormSchema: formSchema,
+		IsActive:         true,
+		CategoryID:       categoryID,
+		SKUs:             []UpstreamSKU{sku},
+	}, nil
+}
+
+func fansgurusCategoryIDs(services []FansgurusService) map[string]uint {
+	categories := make(map[string]uint)
+	for _, service := range services {
+		name := normalizedFansgurusCategory(service.Category)
+		if _, ok := categories[name]; !ok {
+			categories[name] = uint(len(categories) + 1)
+		}
+	}
+	return categories
+}
+
+func paginateFansgurusProducts(products []UpstreamProduct, opts ListProductsOpts) []UpstreamProduct {
+	if opts.Page <= 0 || opts.PageSize <= 0 {
+		return products
+	}
+	start := (opts.Page - 1) * opts.PageSize
+	if start >= len(products) {
+		return []UpstreamProduct{}
+	}
+	end := start + opts.PageSize
+	if end > len(products) {
+		end = len(products)
+	}
+	return products[start:end]
+}
+
+func buildFansgurusManualFormSchema(serviceType string) models.JSON {
+	switch strings.TrimSpace(serviceType) {
+	case "Custom Comments":
+		return models.JSON{"fields": []interface{}{
+			fansgurusManualField("link", "text", true),
+			fansgurusManualField("comments", "textarea", true),
+		}}
+	case "Poll":
+		return models.JSON{"fields": []interface{}{
+			fansgurusManualField("link", "text", true),
+			fansgurusManualField("answer_number", "number", true),
+		}}
+	case "Mentions":
+		return models.JSON{"fields": []interface{}{
+			fansgurusManualField("link", "text", true),
+			fansgurusManualField("usernames", "textarea", true),
+		}}
+	default:
+		return models.JSON{"fields": []interface{}{
+			fansgurusManualField("link", "text", true),
+		}}
+	}
+}
+
+func fansgurusManualField(key, fieldType string, required bool) map[string]interface{} {
+	return map[string]interface{}{
+		"key":      key,
+		"type":     fieldType,
+		"required": required,
+		"label":    localizedFansgurusText(key),
+	}
+}
+
+func localizedFansgurusText(value string) models.JSON {
+	value = strings.TrimSpace(value)
+	return models.JSON{"zh-CN": value, "zh-TW": value, "en-US": value}
+}
+
+func normalizedFansgurusCategory(value string) string {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return "Fansgurus"
+	}
+	return value
+}
+
+func slugifyFansgurusCategory(value string) string {
+	value = strings.ToLower(normalizedFansgurusCategory(value))
+	replacer := strings.NewReplacer(" ", "-", "/", "-", "_", "-", "&", "and")
+	return replacer.Replace(value)
+}
+
+func stringFromJSON(payload models.JSON, key string) string {
+	if payload == nil {
+		return ""
+	}
+	value, ok := payload[key]
+	if !ok || value == nil {
+		return ""
+	}
+	return strings.TrimSpace(fmt.Sprint(value))
+}
+
+func normalizeFansgurusOrderStatus(status string) string {
+	switch strings.ToLower(strings.TrimSpace(status)) {
+	case "completed", "complete":
+		return fansgurusStatusComplete
+	case "in progress", "processing":
+		return fansgurusStatusRunning
+	case "partial":
+		return fansgurusStatusPartial
+	case "canceled", "cancelled":
+		return fansgurusStatusCanceled
+	case "failed":
+		return fansgurusStatusFailed
+	default:
+		return fansgurusStatusPending
+	}
+}
