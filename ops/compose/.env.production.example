# Copy this file outside git-tracked paths before filling real production values.
# Do not commit real secrets.

COMPOSE_PROJECT_NAME=target-site

# Image tags.
APP_VERSION=target-YYYYMMDD

# Public domains.
FINAL_DOMAIN=https://FINAL_DOMAIN
FINAL_ADMIN_DOMAIN=https://FINAL_ADMIN_DOMAIN
FINAL_API_DOMAIN=https://FINAL_API_DOMAIN

# Frontend build-time public values.
# Do not include /api/v1. The apps append that prefix internally.
VITE_API_BASE_URL=https://FINAL_API_DOMAIN
VITE_ADMIN_PATH=

# Backend runtime paths.
DUJIAO_CONFIG_PATH=./secrets/config.yml
UPLOADS_PATH=./data/uploads
LOGS_PATH=./data/logs

# Database.
POSTGRES_DB=dujiao
POSTGRES_USER=dujiao
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DATA_PATH=./data/postgres

# Redis.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DATA_PATH=./data/redis

# Optional local port bindings. Keep API private behind reverse proxy where possible.
API_HOST_PORT=127.0.0.1:8080
USER_HOST_PORT=127.0.0.1:8081
ADMIN_HOST_PORT=127.0.0.1:8082
