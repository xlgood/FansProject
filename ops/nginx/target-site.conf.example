# Nginx reverse proxy example for separated deployment.
# Replace FINAL_* placeholders and certificate paths before use.

map $http_cf_ipcountry $target_country_code {
    default $http_cf_ipcountry;
    ""      $http_cloudfront_viewer_country;
}

upstream target_user_web {
    server 127.0.0.1:8081;
    keepalive 32;
}

upstream target_admin_web {
    server 127.0.0.1:8082;
    keepalive 16;
}

upstream target_api {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name FINAL_DOMAIN FINAL_ADMIN_DOMAIN FINAL_API_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name FINAL_DOMAIN;

    ssl_certificate /etc/nginx/certs/FINAL_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/FINAL_DOMAIN/privkey.pem;

    client_max_body_size 10m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # 'unsafe-eval' is temporary until Vue locale messages are precompiled.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://FINAL_API_DOMAIN; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://FINAL_API_DOMAIN" always;

    location ^~ /api/v1/ {
        proxy_pass http://target_api;
        include /etc/nginx/snippets/target-proxy-headers.conf;
    }

    # Serve crawler-facing files from the API instead of the SPA fallback.
    location = /sitemap.xml {
        proxy_pass http://target_api;
        include /etc/nginx/snippets/target-proxy-headers.conf;
    }

    location = /robots.txt {
        proxy_pass http://target_api;
        include /etc/nginx/snippets/target-proxy-headers.conf;
    }

    location = /health {
        proxy_pass http://target_user_web;
        include /etc/nginx/snippets/target-proxy-headers.conf;
    }

    location / {
        proxy_pass http://target_user_web;
        include /etc/nginx/snippets/target-proxy-headers.conf;
    }
}

server {
    listen 443 ssl http2;
    server_name FINAL_ADMIN_DOMAIN;

    ssl_certificate /etc/nginx/certs/FINAL_ADMIN_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/FINAL_ADMIN_DOMAIN/privkey.pem;

    client_max_body_size 10m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # 'unsafe-eval' is temporary until Vue locale messages are precompiled.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://FINAL_API_DOMAIN; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://FINAL_API_DOMAIN" always;

    location = /health {
        proxy_pass http://target_admin_web;
        include /etc/nginx/snippets/target-proxy-headers.conf;
    }

    location / {
        proxy_pass http://target_admin_web;
        include /etc/nginx/snippets/target-proxy-headers.conf;
    }
}

server {
    listen 443 ssl http2;
    server_name FINAL_API_DOMAIN;

    ssl_certificate /etc/nginx/certs/FINAL_API_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/FINAL_API_DOMAIN/privkey.pem;

    client_max_body_size 10m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" always;

    location = /health {
        proxy_pass http://target_api;
        include /etc/nginx/snippets/target-proxy-headers.conf;
    }

    location ^~ /api/v1/ {
        proxy_pass http://target_api;
        include /etc/nginx/snippets/target-proxy-headers.conf;
    }

    location / {
        return 404;
    }
}
