# Fansgurus upstream API.
FANSGURUS_API_BASE_URL=https://fansgurus.com/api/v2
FANSGURUS_API_KEY=

# Website3 pricing rule.
PRICE_MULTIPLIER=10
DISPLAY_CURRENCY=USD

# SKU sync behavior.
SKU_SYNC_INTERVAL_SECONDS=300
SKU_SYNC_TIMEOUT_SECONDS=30

# Order status polling behavior.
ORDER_STATUS_FAST_INTERVAL_SECONDS=60
ORDER_STATUS_SLOW_INTERVAL_SECONDS=900

# Dujiao-Next external source location used by local scripts or deployment docs.
DUJIAO_NEXT_REPO=https://github.com/dujiao-next/dujiao-next.git
