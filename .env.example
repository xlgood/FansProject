# FansGurus upstream API.
FANSGURUS_API_BASE_URL=https://fansgurus.com/api/v2
FANSGURUS_API_KEY=

# TGX Account upstream API.
TGX_API_BASE_URL=https://www.tgxaccount.com/shared
TGX_APP_ID=
TGX_APP_KEY=

# Provider pricing rules.
FANSGURUS_PRICE_MULTIPLIER=5
TGX_PRICE_MULTIPLIER=1.2
TGX_PRICE_BASE_FIELD=price
DISPLAY_CURRENCY=USD
SETTLEMENT_CURRENCY=USD

# Payment provider enablement. Provider credentials belong in deployment secrets.
ENABLE_ALIPAY=true
ENABLE_WECHAT_PAY=true
ENABLE_PAYPAL=true

# SKU sync behavior.
SKU_SYNC_INTERVAL_SECONDS=300
SKU_SYNC_TIMEOUT_SECONDS=30

# Order status polling behavior.
ORDER_STATUS_FAST_INTERVAL_SECONDS=60
ORDER_STATUS_SLOW_INTERVAL_SECONDS=900

# Dujiao-Next local source locations.
DUJIAO_NEXT_API_DIR=./dujiao-next
DUJIAO_NEXT_USER_DIR=./user
DUJIAO_NEXT_ADMIN_DIR=./admin
DUJIAO_NEXT_DOCUMENT_DIR=./document

# Use one root .env for project-level integration settings.
ENV_STRATEGY=single-root-env

# Temporary domain placeholders. Replace before production launch.
PUBLIC_SITE_URL=https://example-target.test
ADMIN_SITE_URL=https://admin.example-target.test
BRAND_ASSET_PROFILE=default
